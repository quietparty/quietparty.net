---
import BaseHead from "../../components/base-head.astro"
import PageHeader from "../../components/page-header.astro"
---

<BaseHead
	title="ritual (single) by quiet party"
	description="ritual (single) by quiet party"
/>
<style>
	:root {
		background: black;
		color: white;
		font-family: "quiet party", Iosevka, monospace;
	}

	main {
		padding: 0 2rem;
		line-height: 1.2;
	}

	h1 {
		font-weight: 300;
		font-size: 3.2rem;
		margin: 0;
		line-height: 1;
		font-family: "Iosevka QP", Iosevka, monospace;
	}

	a {
		color: #00ffff;
	}
</style>
<PageHeader />
<main>
	<center>
		<svg
			width="500"
			height="500"
			viewBox="0 0 6000 5000"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				fill="#ffffff"
				fill-rule="evenodd"
				stroke="none"
				d="M 3000 756.382324 L 415 5243.888672 L 5585 5243.888672 Z"></path>
			<path
				fill="#00ffff"
				fill-rule="evenodd"
				stroke="none"
				d="M 3310.021484 1294.573242 L 1035.043091 5243.888672 L 5585 5243.888672 Z"
			></path>
		</svg>

		<h1>ritual<br />quiet party</h1>
	</center>

	<p>
		available on:
		<ul>
			<li>
				<a href="https://quiet-party.bandcamp.com/album/ritual"> bandcamp </a>
			</li>
			<li>
				<a href="https://music.apple.com/us/album/ritual-single/1861365839">
					itunes
				</a>
			</li>
			<li>
				<a href="https://open.spotify.com/album/3tHDe6iivBKGnmlCwhCAcv">
					spotify
				</a>
			</li>
			<li>
				everywhere else too,<br />
				you know how to use your music software,<br />
				type "quiet party field disturbances" in the search box.
			</li>
		</ul>
		<h3 style="position:fixed;right:10px;bottom:10px">stereo</h3>
	</p>
</main>
