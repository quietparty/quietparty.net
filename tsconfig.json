{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"strictNullChecks": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": {
			"::assets/": ["./src/assets/"]
		},
		"noEmit": true,
		"allowImportingTsExtensions": true
	}
}
